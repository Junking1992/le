[
 {
  "en": "Explain something to me, Blanco, One minute you plead for your friend's life, and the next minute you want to take it.",
  "start": 17.74,
  "end": 23.19
 },
 {
  "en": "This man...",
  "start": 23.2,
  "end": 25.0
 },
