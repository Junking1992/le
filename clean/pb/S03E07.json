  "end": 218.05
 },
 {
  "en": "Stay calm.",
  "start": 219.91,
  "end": 220.69
 },
 {
  "en": "Better knuckle up.",
  "start": 235.34,
  "end": 236.25
 },
 {
  "en": "Look, I don't know what you're thinking, but killing me is not going to solve your problem.",
