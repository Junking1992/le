  "start": 1043.02,
  "end": 1046.24
 },
 {
  "en": "The sooner he's dead, the sooner we can get on the escape.",
  "start": 1046.29,
  "end": 1049.33
 },
 {
  "en": "No games. I'm in.",
  "start": 1049.37,
  "end": 1050.39
 },
 {
  "en": "You're in.",
  "start": 1050.44,
  "end": 1051.91
 },
 {
  "en": "No, no, no.",
  "start": 1052.97,
  "end": 1054.28
 },
 {
  "en": "What's wrong?",
  "start": 1054.31,
  "end": 1054.89
 },
 {
  "en": "We got to call off the fight.",
  "start": 1054.9,
  "end": 1056.47
 },
 {
  "en": "No, that's an impossibility.",
  "start": 1056.48,
  "end": 1058.11
 },
 {
  "en": "No, no, no, you don't understand!",
  "start": 1058.14,
  "end": 1060.64
 },
 {
  "en": "There's got to be more Acetone around here.",
