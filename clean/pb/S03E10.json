  "en": "Funny, I'm feeling pretty secure right about now.",
  "start": 2010.24,
  "end": 2013.6
 },
 {
  "en": "Now, the combination, old man.",
  "start": 2013.61,
  "end": 2016.43
 },
 {
  "en": "We're not asking again.",
  "start": 2016.44,
  "end": 2019.13
 },
 {
  "en": "Sammy!",
  "start": 2020.26,
  "end": 2022.43
 },
 {
  "en": "I'm opening the door.",
  "start": 2022.44,
  "end": 2023.4
 },
 {
  "en": "Michael, do not open the...",
  "start": 2023.41,
  "end": 2025.57
 },
 {
  "en": "Drop 'em!",
  "start": 2028.17,
  "end": 2029.28
 },
