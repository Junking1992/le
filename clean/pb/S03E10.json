  "end": 2135.59
 },
 {
  "en": "How long is this going to set us back?",
  "start": 2170.91,
  "end": 2172.47
 },
 {
  "en": "What's gonna set us back is if the tower guards are looking at a giant sinkhole out in no man's land.",
  "start": 2172.48,
  "end": 2177.65
 },
 {
  "en": "Michael?",
  "start": 2186.2,
  "end": 2188.64
 },
 {
  "en": "We're good.",
  "start": 2199.6,
  "end": 2201.53
 },
 {
  "en": "Yeah.",
  "start": 2199.6,
  "end": 2201.53
 },
 {
  "en": "We're good.",
  "start": 2204.29,
  "end": 2206.16
 },
 {
  "en": "Back in business.",
  "start": 2236.85,
  "end": 2238.64
 },
 {
  "en": "I'm in.",
  "start": 2239.73,
  "end": 2240.5
 },
