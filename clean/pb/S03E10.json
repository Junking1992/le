  "end": 1062.97
 },
 {
  "en": "No, that's it!",
  "start": 1063.01,
  "end": 1064.02
 },
 {
  "en": "I can't go against Sammy straight up!",
  "start": 1064.04,
  "end": 1066.18
 },
 {
  "en": "I'm a dead man!",
  "start": 1066.22,
  "end": 1067.05
 },
 {
  "en": "If you don't kill him, we are all dead.",
  "start": 1067.08,
  "end": 1070.96
 },
 {
  "en": "This isn't the best neighborhood.",
  "start": 1092.06,
  "end": 1094.5
 },
 {
  "en": "I've been in a lot worse.",
  "start": 1095.23,
  "end": 1096.18
 },
 {
  "en": "Just stick close.",
  "start": 1096.22,
  "end": 1097.93
 },
 {
  "en": "Osberto?",
  "start": 1105.08,
  "end": 1106.91
 },
 {
  "en": "Si.",
  "start": 1107.75,
  "end": 1109.58
 },
 {
  "en": "You want to do this?",
  "start": 1109.64,
  "end": 1111.94
 },
 {
  "en": "¿Tiene el dinero?",
  "start": 1115.12,
  "end": 1116.85
 },
 {
  "en": "Yeah, yeah, I got it.",
  "start": 1116.87,
  "end": 1119.47
 },
 {
  "en": "¿Dónde está?",
  "start": 1136.66,
  "end": 1138.41
 },
 {
  "en": "\"Where is the money?\"",
  "start": 1138.48,
  "end": 1140.84
 },
 {
  "en": "I want to see the product.",
  "start": 1144.37,
  "end": 1146.86
 },
 {
  "en": "\"Money first. \"",
  "start": 1151.87,
  "end": 1152.57
 },
 {
  "en": "Show me the stuff.",
  "start": 1152.6,
  "end": 1154.05
 },
 {
  "en": "El dinero!",
  "start": 1154.07,
  "end": 1156.11
 },
 {
  "en": "Lincoln, please, let's get out of here.",
  "start": 1156.22,
  "end": 1157.37
 },
 {
  "en": "Tell him to stop wasting my time.",
