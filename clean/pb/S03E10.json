  "end": 214.83
 },
 {
  "en": "But you're staying up here.",
  "start": 214.86,
  "end": 216.05
 },
 {
  "en": "Maybe I didn't enunciate myself.",
  "start": 216.08,
  "end": 218.42
 },
 {
  "en": "The work downstairs requires two hands.",
  "start": 218.45,
  "end": 222.57
 },
 {
  "en": "Hey.",
  "start": 223.05,
  "end": 224.65
 },
 {
  "en": "We need somebody to stay outside in case Sammy returns.",
  "start": 225.0,
  "end": 228.39
 },
 {
  "en": "I thought we couldn't dig through this stuff.",
  "start": 250.43,
  "end": 252.67
 },
 {
  "en": "The bracing's gonna be tricky.",
  "start": 252.71,
  "end": 253.94
 },
 {
  "en": "Unless the tunnel gets the proper support, it's all going to come down on our heads.",
  "start": 253.98,
  "end": 257.71
 },
 {
  "en": "We should have the materials for the braces, but we'll need a a saw to cut them to size.",
  "start": 257.72,
  "end": 261.22
 },
 {
  "en": "And a hammer.",
  "start": 261.25,
  "end": 263.26
 },
 {
  "en": "Can you help us out?",
  "start": 263.3,
  "end": 264.84
 },
 {
  "en": "Yeah. I can do that.",
  "start": 264.85,
  "end": 267.0
 },
 {
  "en": "Two days.",
  "start": 270.31,
  "end": 272.22
 },
 {
  "en": "And if not?",
